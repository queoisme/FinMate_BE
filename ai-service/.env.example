DATABASE_URL=postgresql+asyncpg://finmate:finmate@localhost:5434/finmate_ai
REDIS_URL=redis://localhost:6379
INTERNAL_API_KEY=change-me-min-32-chars-local-dev-internal-key
MODEL_REGISTRY_PATH=./models
LOG_LEVEL=INFO
COLLECT_RAW_SAMPLES=true
SEED_PROVIDER_PATTERNS=true

# OCR service riêng (PaddleOCR + VietOCR). Giá trị khóa phải giống ocr-service/.env.
# URL do docker-compose đặt; chạy ngoài docker thì đặt OCR_SERVICE_URL=http://localhost:<cổng> ở đây.
OCR_SERVICE_API_KEY=change-me-min-32-chars-local-dev-ocr-key

# Rasa (hiểu ý định câu chat) cho POST /api/v1/chat/parse. docker-compose đặt http://rasa:5005; để trống thì chỉ dùng luật.
# RASA_URL=http://localhost:5005
# Khoản chi chắc chắn dưới mức này (đồng) được đánh dấu auto_save_ok; 0 = không bao giờ.
# CHAT_AUTO_SAVE_BELOW=2000000
