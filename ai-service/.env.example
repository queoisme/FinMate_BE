DATABASE_URL=postgresql+asyncpg://finmate:finmate@localhost:5434/finmate_ai
REDIS_URL=redis://localhost:6379
INTERNAL_API_KEY=change-me-min-32-chars-local-dev-internal-key
MODEL_REGISTRY_PATH=./models
LOG_LEVEL=INFO
COLLECT_RAW_SAMPLES=true
SEED_PROVIDER_PATTERNS=true
SEED_BILL_KNOWLEDGE=true

# OCR service riêng (PaddleOCR + VietOCR). Giá trị khóa phải giống ocr-service/.env.
# URL do docker-compose đặt; chạy ngoài docker thì đặt OCR_SERVICE_URL=http://localhost:<cổng> ở đây.
OCR_SERVICE_API_KEY=change-me-min-32-chars-local-dev-ocr-key

# Rasa (hiểu ý định câu chat) cho POST /api/v1/chat/parse. docker-compose đặt http://rasa:5005; để trống thì chỉ dùng luật.
# RASA_URL=http://localhost:5005
# Khoản chi chắc chắn dưới mức này (đồng) được đánh dấu auto_save_ok; 0 = không bao giờ.
# CHAT_AUTO_SAVE_BELOW=2000000

# Gemini phân loại tên món trên hóa đơn khi luật/ML không chắc (chỉ gửi tên món, không giá/cửa hàng). Để trống thì tắt.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
# GEMINI_TIMEOUT_SECONDS=20
# Dự phòng khi mọi model Gemini lỗi: OpenRouter (chỉ tên món gửi đi, cũng cần người dùng đồng ý như Gemini)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Khóa chủ AES-256 (32 byte, base64) mã hóa key bên thứ ba mà admin nhập qua trang quản trị (Cấu hình hệ thống > Tích hợp bên thứ ba). Để trống thì không lưu được key ở DB;
# key ở biến môi trường ở trên vẫn chạy. Sinh một khóa: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Mất khóa này là mất các key đã lưu ở DB (nhập lại được). KHÔNG commit giá trị thật.
# SECRETS_MASTER_KEY=
# Chọn cách quản lý tài chính: dự phòng thứ hai sau Gemini (chỉ model :free; luôn gửi data_collection=deny). Để trống METHOD_OPENROUTER_MODELS = tắt.
# METHOD_OPENROUTER_MODELS=dots-studio/dots-3-note-preview:free
# METHOD_OPENROUTER_TIMEOUT_SECONDS=10
# METHOD_TOTAL_SECONDS=24
