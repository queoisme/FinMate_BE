DATABASE_URL=Host=localhost;Port=5433;Database=finmate_main;Username=finmate;Password=finmate
REDIS_URL=localhost:6379
JWT_SECRET=change-me-to-a-random-64-char-minimum-secret-string-for-local-dev-only
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
GOOGLE_CLIENT_ID=change-me-to-your-oauth-client-id.apps.googleusercontent.com
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_API_KEY=change-me-min-32-chars-local-dev-internal-key
HANGFIRE_DASHBOARD_USER=admin
HANGFIRE_DASHBOARD_PASS=change-me-local-dev
ADMIN_SEED_EMAIL=admin@finmate.local
ADMIN_SEED_PASSWORD=ChangeMe123!

# Push notification (FCM). Để TRỐNG cả hai thì backend chạy log-only — mọi logic chọn người
# nhận vẫn chạy, chỉ không đẩy xuống máy thật. Dòng log lúc khởi động nói rõ đang ở chế độ nào.
# Chọn MỘT trong hai: PATH cho file service-account mount vào container, JSON cho secret dán
# thẳng biến môi trường. File này là khoá gửi thông báo cho toàn bộ người dùng — không commit.
FCM_CREDENTIALS_PATH=
FCM_CREDENTIALS_JSON=

# Rate limiting. Bỏ trống thì dùng mặc định: 120/phút cho mọi request (phân vùng theo user id
# khi đã đăng nhập, theo IP khi chưa) và 10/phút cho đăng nhập/đăng ký/Google (theo IP).
RATE_LIMIT_DEFAULT_PER_MINUTE=
RATE_LIMIT_AUTH_PER_MINUTE=

# Reverse proxy. Trống = KHÔNG bật (mặc định an toàn) — X-Forwarded-For bị bỏ qua và rate limit
# đếm theo IP thật của kết nối. Đặt danh sách IP proxy khi chạy sau nginx/ALB; đặt "*" để tin
# mọi forwarder (một số PaaS bắt buộc), nhưng chỉ khi nền tảng ĐÃ tự ghi đè header ở biên —
# nếu không, client tự đặt IP giả để thoát rate limit.
TRUSTED_PROXIES=
