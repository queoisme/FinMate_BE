# Khóa nội bộ: chỉ ai-service được gọi OCR service. Phải giống OCR_SERVICE_API_KEY trong ai-service/.env.
OCR_SERVICE_API_KEY=change-me-min-32-chars-local-dev-ocr-key

# Lưu trữ dùng chung qua API của ai-service (không kết nối DB). Khóa phải giống INTERNAL_API_KEY trong ai-service/.env. docker-compose đã đặt AI_SERVICE_URL;
# chạy ngoài docker thì đặt thêm AI_SERVICE_URL=http://localhost:8000. Thiếu một trong hai thì dùng file cạnh code và bảng mặc định trong code.
AI_SERVICE_API_KEY=change-me-min-32-chars-local-dev-internal-key

# OCR bằng Google Cloud Vision (đường chính). Để trống GOOGLE_VISION_API_KEY thì chỉ dùng OCR cục bộ (PaddleOCR + VietOCR); Google lỗi cũng rơi về OCR cục bộ.
# ẢNH HÓA ĐƠN RỜI HỆ THỐNG SANG GOOGLE (luôn gửi khi có khóa): câu chữ màn đồng ý phải nói đúng điều này. Giới hạn khóa theo Cloud Vision API và địa chỉ máy chủ.
GOOGLE_VISION_API_KEY=
# Khóa này chỉ là DỰ PHÒNG: khóa admin nhập trên trang quản trị (kho key của AI Service, cần AI_SERVICE_URL và AI_SERVICE_API_KEY) được ưu tiên.
# auto (mặc định: dùng Google khi có khóa) | local (ép OCR cục bộ, dùng khi đo so sánh hai bên)
FINMATE_OCR_ENGINE=auto
GOOGLE_VISION_TIMEOUT_SECONDS=20
# Sau một lần Google lỗi, tạm nghỉ chừng này giây để các lần quét sau không phải chờ lỗi lại
GOOGLE_VISION_COOLDOWN_SECONDS=60
