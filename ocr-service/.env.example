# Khóa nội bộ: chỉ ai-service được gọi OCR service. Phải giống OCR_SERVICE_API_KEY trong ai-service/.env.
OCR_SERVICE_API_KEY=change-me-min-32-chars-local-dev-ocr-key

# docker-compose đặt FINMATE_DATABASE_URL trỏ tới postgres-ocr. Chạy ngoài docker mà bỏ trống thì dùng file cạnh code và bảng mặc định trong code.
