<mxCell id="B7" value="Save the recommendation with prompt_version and method_version" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#333333;fontSize=13;spacing=4;" vertex="1" parent="1"><mxGeometry x="680" y="1695" width="240" height="60" as="geometry" /></mxCell>
