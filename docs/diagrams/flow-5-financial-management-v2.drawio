<mxCell id="A1" value="Show the onboarding survey: up to 10 questions, one per screen, skippable" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#333333;fontSize=13;spacing=4;" vertex="1" parent="1"><mxGeometry x="360" y="521" width="240" height="80" as="geometry" /></mxCell>
