<mxCell id="B5" value="Build the prompt: signals plus the allowed method list only" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#333333;fontSize=13;spacing=4;" vertex="1" parent="1"><mxGeometry x="680" y="1211" width="240" height="60" as="geometry" /></mxCell>
<mxCell id="I1" value="Rank the shortlist; pick 1 primary and at most 1 supporting method; return JSON with reasons" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#333333;fontSize=13;spacing=4;" vertex="1" parent="1"><mxGeometry x="1000" y="1201" width="240" height="80" as="geometry" /></mxCell>
