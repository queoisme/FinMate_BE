<mxCell id="B3" value="Derive user signals from the answers (income volatility, shortfall, effort, goals)" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#333333;fontSize=13;spacing=4;" vertex="1" parent="1"><mxGeometry x="680" y="929" width="240" height="80" as="geometry" /></mxCell>
