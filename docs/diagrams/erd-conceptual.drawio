target="k7c173"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k7l177" value="(1,1)" style="edgeLabel;html=1;resizable=0;fontSize=11;fontStyle=1;fontColor=#1f4e79;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="k7e176"><mxGeometry x="-0.72" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="k7c178" value='&lt;b&gt;dự đoán&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;(Nhãn dự đoán)&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;(Nhãn đúng)&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;(Độ tin cậy)&lt;/font&gt;' style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1072" y="978" width="176" height="104" as="geometry"/></mxCell><mxCell id="k7e179" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="k7c28" target="k7c178"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k7l180" value="(0,n)" style="edgeLabel;html=1;resizable=0;fontSize=11;fontStyle=1;fontColor=#1f4e79;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="k7e179"><mxGeometry x="-0.72" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="k7e181" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="k7c17" target="k7c178"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k7l182" value="(0,n)" style="edgeLabel;html=1;resizable=0;fontSize=11;fontStyle=1;fontColor=#1f4e79;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="k7e181"><mxGeometry x="-0.72" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="k7c183" value="&lt;b&gt;KN-7 Tổng quan phân hệ AI&lt;/b&gt;&lt;br&gt;32 thực thể của ai-service, chỉ ghi tên. Liên kết với NGƯỜI DÙNG, GIAO DỊCH… là logic (qua mã băm), xem KN-8 … KN-10." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;spacingLeft=8;spacingTop=6;fillColor=#fffde7;strokeColor=#c9b800;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="74" as="geometry"/></mxCell><mxCell id="k7c184" value="&lt;b&gt;Ký hiệu&lt;/b&gt;: hình chữ nhật = thực thể · hình thoi = mối kết hợp (thuộc tính của mối kết hợp ghi trong ngoặc)&lt;br&gt;&lt;u&gt;gạch chân&lt;/u&gt; = khóa · &lt;i&gt;/nghiêng&lt;/i&gt; = thuộc tính dẫn xuất · (min,max) = số lần thực thể tham gia mối kết hợp&lt;br&gt;nét đứt = liên kết logic, không có khóa ngoại ở mức vật lý · hộp xám viền đứt = thực thể ở trang khác" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1080" y="20" width="640" height="74" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="k8" name="KN-8 AI — tri thức phân loại và định dạng thông báo"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="k8c1" value='&lt;b&gt;DANH MỤC AI&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#555555"&gt;kb_categories&lt;/font&gt;' style="swimlane;html=1;startSize=44;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="419" y="808" width="190" height="144" as="geometry"/></mxCell><mxCell id="k8c2" value="&lt;u&gt;Slug&lt;/u&gt;&lt;br&gt;Nhãn&lt;br&gt;Loại (thu / chi)&lt;br&gt;Phiên bản phân loại&lt;br&gt;Đang hoạt động" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=12;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="k8c1"><mxGeometry x="0" y="44" width="190" height="100" as="geometry"/></mxCell><mxCell id="k8c3" value='&lt;b&gt;THƯƠNG HIỆU&lt;/b&gt;&lt;br&gt;