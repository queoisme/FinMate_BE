d="k5l57" value="(0,1)" style="edgeLabel;html=1;resizable=0;fontSize=11;fontStyle=1;fontColor=#1f4e79;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="k5e56"><mxGeometry x="-0.72" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="k5c58" value='&lt;b&gt;KN-5 Phương pháp tài chính và khảo sát&lt;/b&gt;&lt;br&gt;"chọn" (người dùng – lựa chọn) và "gợi ý" (phương pháp – mẫu mục tiêu) là mối kết hợp nhiều – nhiều.' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;spacingLeft=8;spacingTop=6;fillColor=#fffde7;strokeColor=#c9b800;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="74" as="geometry"/></mxCell><mxCell id="k5c59" value="&lt;b&gt;Ký hiệu&lt;/b&gt;: hình chữ nhật = thực thể · hình thoi = mối kết hợp (thuộc tính của mối kết hợp ghi trong ngoặc)&lt;br&gt;&lt;u&gt;gạch chân&lt;/u&gt; = khóa · &lt;i&gt;/nghiêng&lt;/i&gt; = thuộc tính dẫn xuất · (min,max) = số lần thực thể tham gia mối kết hợp&lt;br&gt;nét đứt = liên kết logic, không có khóa ngoại ở mức vật lý · hộp xám viền đứt = thực thể ở trang khác" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1080" y="20" width="640" height="74" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="k6" name="KN-6 Báo cáo và dự báo tài chính"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="k6c1" value='&lt;b&gt;TỔNG HỢP NGÀY&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#555555"&gt;daily_summaries&lt;/font&gt;' style="swimlane;html=1;startSize=44;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="899" y="1131" width="223" height="162" a