metry x="-0.72" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="k6c60" value="&lt;b&gt;KN-6 Báo cáo và dự báo tài chính&lt;/b&gt;&lt;br&gt;Bất thường gắn với đúng một giao dịch; cảnh báo dự báo chống gửi lặp bằng khóa chống lặp." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;spacingLeft=8;spacingTop=6;fillColor=#fffde7;strokeColor=#c9b800;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="74" as="geometry"/></mxCell><mxCell id="k6c61" value="&lt;b&gt;Ký hiệu&lt;/b&gt;: hình chữ nhật = thực thể · hình thoi = mối kết hợp (thuộc tính của mối kết hợp ghi trong ngoặc)&lt;br&gt;&lt;u&gt;gạch chân&lt;/u&gt; = khóa · &lt;i&gt;/nghiêng&lt;/i&gt; = thuộc tính dẫn xuất · (min,max) = số lần thực thể tham gia mối kết hợp&lt;br&gt;nét đứt = liên kết logic, không có khóa ngoại ở mức vật lý · hộp xám viền đứt = thực thể ở trang khác" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1080" y="20" width="640" height="74" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="k7" name="KN-7 Tổng quan phân hệ AI"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="k7c1" value='&lt;b&gt;DANH MỤC AI&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#555555"&gt;kb_categories&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="972" y="1649" width="190" height="44" as="geometry"/></mxCell><mxCell id="k7c2" value='&lt;b&gt;THƯƠNG HIỆU&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#555555"&gt;kb_brands&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontS