value="&lt;b&gt;nói&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="1442" y="742" width="110" height="56" as="geometry"/></mxCell><mxCell id="k10e50" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#444444;fontSize=11;dashed=1;" edge="1" parent="1" source="k10c18" target="k10c49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k10l51" value="(0,n)" style="edgeLabel;html=1;resizable=0;fontSize=11;fontStyle=1;fontColor=#1f4e79;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="k10e50"><mxGeometry x="-0.72" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="k10e52" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#444444;fontSize=11;dashed=1;" edge="1" parent="1" source="k10c13" target="k10c49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k10l53" value="(1,1)" style="edgeLabel;html=1;resizable=0;fontSize=11;fontStyle=1;fontColor=#1f4e79;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="k10e52"><mxGeometry x="-0.72" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="k10c54" value='&lt;b&gt;KN-10 AI — model, đánh giá, NLU&lt;/b&gt;&lt;br&gt;"dự đoán" là mối kết hợp nhiều – nhiều giữa lượt đánh giá và mẫu gắn nhãn, mang kết quả từng mẫu.' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;spacingLeft=8;spacingTop=6;fillColor=#fffde7;strokeColor=#c9b800;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="74" as="geometry"/></mxCell><mxCell id="k10c55" value="&lt;b&gt;Ký hiệu&lt;/b&gt;: hình chữ nhật = thực thể · hình thoi = mối kết hợp (thuộc tính của mối kết hợp ghi trong ngoặc)&lt;br&gt;&lt;u&gt;gạch chân&lt;/u&gt; = khóa · &lt;i&gt;/nghiêng&lt;/i&gt; = thuộc tính dẫn xuất · (min,max) = số lần thực thể tham gia mối kết hợp&lt;br&gt;nét đứt = liên kết logic, không có khóa ngoại ở mức vật lý · hộp xám viền đứt = thực thể ở trang khác" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1080" y="20" width="640" height="74" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
