&gt;: hình chữ nhật = thực thể · hình thoi = mối kết hợp (thuộc tính của mối kết hợp ghi trong ngoặc)&lt;br&gt;&lt;u&gt;gạch chân&lt;/u&gt; = khóa · &lt;i&gt;/nghiêng&lt;/i&gt; = thuộc tính dẫn xuất · (min,max) = số lần thực thể tham gia mối kết hợp&lt;br&gt;nét đứt = liên kết logic, không có khóa ngoại ở mức vật lý · hộp xám viền đứt = thực thể ở trang khác" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1080" y="20" width="640" height="74" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="k9" name="KN-9 AI — phân tích thông báo, phản hồi, dữ liệu huấn luyện"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="k9c1" value='&lt;b&gt;LƯỢT PHÂN TÍCH&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#555555"&gt;ops_analyze_log&lt;/font&gt;' style="swimlane;html=1;startSize=44;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1208" y="438" width="216" height="216" as="geometry"/></mxCell><mxCell id="k9c2" value="&lt;u&gt;Mã&lt;/u&gt;&lt;br&gt;Mã yêu cầu của backend&lt;br&gt;Kết quả pipeline&lt;br&gt;Nhãn phân loại&lt;br&gt;Số tiền&lt;br&gt;Độ tin cậy từng bước&lt;br&gt;Nghi trùng&lt;br&gt;Phiên bản model / cấu hình&lt;br&gt;Thời gian xử lý" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=12;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="k9c1"><mxGeometry x="0" y="44" width="216" height="172" as="geometry"/></mxCell><mxCell id="k9c3" value='&lt;b&gt;MẪU THÔ&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#555555"&gt;ml_raw_samples&lt;/font&gt;' style="swimlane;html=1;startSize=44;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSi