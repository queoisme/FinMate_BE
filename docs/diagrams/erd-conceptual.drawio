"k0e243" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="k0c1" target="k0c242"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k0l244" value="(0,n)" style="edgeLabel;html=1;resizable=0;fontSize=11;fontStyle=1;fontColor=#1f4e79;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="k0e243"><mxGeometry x="-0.72" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="k0e245" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="k0c25" target="k0c242"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="831" y="935"/></Array></mxGeometry></mxCell><mxCell id="k0l246" value="(1,1)" style="edgeLabel;html=1;resizable=0;fontSize=11;fontStyle=1;fontColor=#1f4e79;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="k0e245"><mxGeometry x="-0.72" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="k0c247" value="&lt;b&gt;bị đánh dấu&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="736" y="1870" width="153" height="56" as="geometry"/></mxCell><mxCell id="k0e248" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="k0c5" target="k0c247"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1102" y="1715"/></Array></mxGeometry></mxCell><mxCell id="k0l249" value="(0,1)" style="edgeLabel;html=1;resizable=0;fontSize=11;fontStyle=1;fontColor=#1f4e79;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="k0e248"><mxGeometry x="-0.72" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="k0e250" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="k0c26" target="k0c247"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k0l251" value="(1,1)" style="edgeLabel;html=1;resizable=0;fontSize=11;fontStyle=1;fontColor=#1f4e79;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="k0e250"><mxGeometry x="-0.72" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="k0c252" value="&lt;b&gt;KN-0 Tổng quan nghiệp vụ (backend)&lt;/b&gt;&lt;br&gt;26 thực thể nghiệp vụ của phân hệ chính, chỉ ghi tên. Thuộc tính và 7 thực thể kỹ thuật (phiên đăng nhập, thiết bị, nhật ký, cấu hình, khóa bí mật, yêu cầu xóa, ngân hàng VietQR) ở các trang KN-1 … KN-6." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;spacingLeft=8;spacingTop=6;fillColor=#fffde7;strokeColor=#c9b800;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="74" as="geometry"/></mxCell><mxCell id="k0c253" value="&lt;b&gt;Ký hiệu&lt;/b&gt;: hình chữ nhật = thực thể · hình thoi = mối kết hợp (thuộc tính của mối kết hợp ghi trong ngoặc)&lt;br&gt;&lt;u&gt;gạch chân&lt;/u&gt; = khóa · &lt;i&gt;/nghiêng&lt;/i&gt; = thuộc tính dẫn xuất · (min,max) = số lần thực thể tham gia mối kết hợp&lt;br&gt;nét đứt = liên kết logic, không có khóa ngoại ở mức vật lý · hộp xám viền đứt = thực thể ở trang khác" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1080" y="20" width="640" height="74" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="k1" name="KN-1 Người dùng, bảo mật, cấu hình hệ thống"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="k1c1" value='&lt;b&gt;NGƯỜI DÙNG&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#555555"&gt;users&lt;/font&gt;' style="swimlane;html=1;startSize=44;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="610" y="693" width="244" height="252" as="geometry"/></mxCell><mxCell id="k1c2" value="&lt;u&gt;Mã người dùng&lt;/u&gt;&lt;br&gt;Email&lt;br&gt;Mật khẩu (đã băm)&lt;br&gt;Tên hiển thị&lt;br&gt;Vai trò&lt;br&gt;Thu nhập hằng tháng&lt;br&gt;Ngưỡng cảnh báo T1, T2&lt;br&gt;Mức dự phòng dự báo&lt;br&gt;Giờ yên lặng&lt;br&gt;Các mốc đồng ý điều khoản / AI&lt;br&gt;Trạng thái khóa" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=12;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="k1c1"><mxGeometry x="0" y="44" width="244" height="208" as="geometry"/></mxCell><mxCell id="k1c3" value='&lt;b&gt;PHIÊN ĐĂNG NHẬP&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#555555"&gt;refresh_tokens&lt;/font&gt;' style="swimlane;html=1;startSize=44;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1217" y="1299" width="190" height="126" as="geometry"/></mxCell><mxCell id="k1c4" value="&lt;u&gt;Mã phiên&lt;/u&gt;&lt;br&gt;Token làm mới&lt;br&gt;Hết hạn lúc&lt;br&gt;Thu hồi lúc" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=12;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="k1c3"><mxGeometry x="0" y="44" width="190" height="82" as="geometry"/></mxCell><mxCell id="k1c5" value='&lt;b&gt;THIẾT BỊ&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#555555"&gt;device_tokens&lt;/font&gt;' style="swimlane;html=1;startSize=44;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="634" y="1352" width="190" height="126" as="geometry"/></mxCell><mxCell id="k1c6" value="&lt;u&gt;Mã thiết bị&lt;/u&gt;&lt;br&gt;Token FCM&lt;br&gt;Nền tảng&lt;br&gt;Hoạt động lần cuối" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=12;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="k1c5"><mxGeometry x="0" y="44" width="190" height="82" as="geometry"/></mxCell><mxCell id="k1c7" value='&lt;b&gt;YÊU CẦU XÓA DỮ LIỆU&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#555555"&gt;data_deletion_requests&lt;/font&gt;' style="swimlane;html=1;startSize=44;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="647" y="160" width="193" height="126" as="geometry"/></mxCell><mxCell id="k1c8" value="&lt;u&gt;Mã yêu cầu&lt;/u&gt;&lt;br&gt;Ngày yêu cầu&lt;br&gt;Ngày xóa cứng dự kiến&lt;br&gt;Trạng thái" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=12;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="k1c7"><mxGeometry x="0" y="44" width="193" height="82" as="geometry"/></mxCell><mxCell id="k1c9" value='&lt;b&gt;NHẬT KÝ KIỂM TOÁN&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#555555"&gt;audit_logs&lt;/font&gt;' style="swimlane;html=1;startSize=44;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1223" y="209" width="190" height="144" as="geometry"/></mxCell><mxCell id="k1c10" value="&lt;u&gt;Mã nhật ký&lt;/u&gt;&lt;br&gt;Loại sự kiện&lt;br&gt;Dữ liệu kèm&lt;br&gt;Địa chỉ IP&lt;br&gt;Thời điểm" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=12;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="k1c9"><mxGeometry x="0" y="44" width="190" height="100" as="geometry"/></mxCell><mxCell id="k1c11" value='&lt;b&gt;PHIÊN BẢN CẤU HÌNH&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#555555"&gt;system_config_versions&lt;/font&gt;' style="swimlane;html=1;startSize=44;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="64" y="204" width="190" height="144" as="geometry"/></mxCell><mxCell id=