h="161" height="56" as="geometry"/></mxCell><mxCell id="k9e153" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#444444;fontSize=11;dashed=1;" edge="1" parent="1" source="k9c22" target="k9c152"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k9l154" value="(0,n)" style="edgeLabel;html=1;resizable=0;fontSize=11;fontStyle=1;fontColor=#1f4e79;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="k9e153"><mxGeometry x="-0.72" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="k9e155" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#444444;fontSize=11;dashed=1;" edge="1" parent="1" source="k9c9" target="k9c152"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k9l156" value="(1,1)" style="edgeLabel;html=1;resizable=0;fontSize=11;fontStyle=1;fontColor=#1f4e79;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="k9e155"><mxGeometry x="-0.72" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="k9c157" value="&lt;b&gt;lấy mẫu từ&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="1349" y="1802" width="146" height="56" as="geometry"/></mxCell><mxCell id="k9e158" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#444444;fontSize=11;dashed=1;" edge="1" parent="1" source="k9c23" target="k9c157"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k9l159" value="(0,1)" style="edgeLabel;html=1;resizable=0;fontSize=11;fontStyle=1;fontColor=#1f4e79;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="k9e158"><mxGeometry x="-0.72" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="k9e160" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#444444;fontSize=11;dashed=1;" edge="1" parent="1" source="k9c15" target="k9c157"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k9l161" value="(1,1)" style="edgeLabel;html=1;resizable=0;fontSize=11;fontStyle=1;fontColor=#1f4e79;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="k9e160"><mxGeometry x="-0.72" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="k9c162" value="&lt;b&gt;KN-9 AI — phân tích thông báo, phản hồi, dữ liệu huấn luyện&lt;/b&gt;&lt;br&gt;Phía AI không lưu mã người dùng thật, chỉ lưu SHA-256; nét đứt là liên kết logic không có khóa ngoại." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;spacingLeft=8;spacingTop=6;fillColor=#fffde7;strokeColor=#c9b800;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="74" as="geometry"/></mxCell><mxCell id="k9c163" value="&lt;b&gt;Ký hiệu&lt;/b&gt;: hình chữ nhật = thực thể · hình thoi = mối kết hợp (thuộc tính của mối kết hợp ghi trong ngoặc)&lt;br&gt;&lt;u&gt;gạch chân&lt;/u&gt; = khóa · &lt;i&gt;/nghiêng&lt;/i&gt; = thuộc tính dẫn xuất · (min,max) = số lần thực thể tham gia mối kết hợp&lt;br&gt;nét đứt = liên kết logic, không có khóa ngoại ở mức vật lý · hộp xám viền đứt = thực thể ở trang khác" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1080" y="20" width="640" height="74" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="k10" name="KN-10 AI — model, đánh giá, NLU"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="k10c1" value='&lt;b&gt;MODEL&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#555555"&gt;ml_models&lt;/font&gt;' style="swimlane;html=1;startSize=44;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeome