<mxfile host="app.diagrams.net"><diagram id="context" name="Sơ đồ ngữ cảnh"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1754" pageHeight="1900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style='font-size:20px'&gt;Sơ đồ ngữ cảnh hệ thống FinMate&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555'&gt;DFD mức 0 · cập nhật theo code ngày 2026-11-08&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="0" width="760" height="56" as="geometry"/></mxCell><mxCell id="sys" value="&lt;span style='font-size:11px;color:#555'&gt;QUÁ TRÌNH 0&lt;/span&gt;&lt;br&gt;&lt;b style='font-size:20px'&gt;Hệ thống FinMate&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;App Flutter · Web vận hành · Website mua gói&lt;br&gt;Backend · ai-service · ocr-service&lt;br&gt;stt-service · Rasa&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;arcSize=8;" vertex="1" parent="1"><mxGeometry x="600" y="300" width="500" height="480" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;Người dùng&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;khách hàng dùng app&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="220" height="90" as="geometry"/></mxCell><mxCell id="user_in" value="1. Tài khoản, cấu hình, giao dịch" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#1565c0;strokeWidth=1.5;fontSize=11;fontColor=#0d47a1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2778;exitDx=0;exitDy=0;entryX=0;entryY=0.0521;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="user_out" value="2. Bản nháp, số dư, dự báo, cảnh báo" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#e65100;strokeWidth=1.5;fontSize=11;fontColor=#bf360c;labelBackgroundColor=#ffffff;exitX=0;exitY=0.1354;exitDx=0;exitDy=0;entryX=1;entryY=0.7222;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="staff" value="&lt;b&gt;Nhân viên hỗ trợ&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Staff&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="220" height="90" as="geometry"/></mxCell><mxCell id="staff_in" value="3. Xử lý ticket, kiểm duyệt" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#1565c0;strokeWidth=1.5;fontSize=11;fontColor=#0d47a1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2778;exitDx=0;exitDy=0;entryX=0;entryY=0.3229;entryDx=0;entryDy=0;" edge="1" parent="1" source="staff" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="staff_out" value="4. Hàng đợi ticket, dữ liệu khách" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#e65100;strokeWidth=1.5;fontSize=11;fontColor=#bf360c;labelBackgroundColor=#ffffff;exitX=0;exitY=0.4062;exitDx=0;exitDy=0;entryX=1;entryY=0.7222;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="staff"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ops" value="&lt;b&gt;Quản lý vận hành&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;OpsManager&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="220" height="90" as="geometry"/></mxCell><mxCell id="ops_in" value="5. Phân công, duyệt, cấu hình gói" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#1565c0;strokeWidth=1.5;fontSize=11;fontColor=#0d47a1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2778;exitDx=0;exitDy=0;entryX=0;entryY=0.5938;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ops_out" value="6. Dashboard, sự cố, thống kê" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#e65100;strokeWidth=1.5;fontSize=11;fontColor=#bf360c;labelBackgroundColor=#ffffff;exitX=0;exitY=0.6771;exitDx=0;exitDy=0;entryX=1;entryY=0.7222;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="ops"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="admin" value="&lt;b&gt;Quản trị viên&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Admin&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="220" height="90" as="geometry"/></mxCell><mxCell id="admin_in" value="7. Phân quyền, cấu hình hệ thống" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#1565c0;strokeWidth=1.5;fontSize=11;fontColor=#0d47a1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2778;exitDx=0;exitDy=0;entryX=0;entryY=0.8646;entryDx=0;entryDy=0;" edge="1" parent="1" source="admin" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="admin_out" value="8. Audit, lỗi kỹ thuật, thống kê" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#e65100;strokeWidth=1.5;fontSize=11;fontColor=#bf360c;labelBackgroundColor=#ffffff;exitX=0;exitY=0.9479;exitDx=0;exitDy=0;entryX=1;entryY=0.7222;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="admin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="android" value="&lt;b&gt;Android OS&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;thông báo từ app ngân hàng / ví&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="120" width="200" height="90" as="geometry"/></mxCell><mxCell id="android_in" value="9. Thông báo biến động số dư" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#1565c0;strokeWidth=1.5;fontSize=11;fontColor=#0d47a1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.28;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="android" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bankapp" value="&lt;b&gt;App ngân hàng&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;mở qua dl.vietqr.io&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="900" y="120" width="200" height="90" as="geometry"/></mxCell><mxCell id="bankapp_out" value="10. Deep link chuyển khoản" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#e65100;strokeWidth=1.5;fontSize=11;fontColor=#bf360c;labelBackgroundColor=#ffffff;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="bankapp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="google" value="&lt;b&gt;Google Sign-In&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;OAuth 2.0&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1440" y="300" width="240" height="90" as="geometry"/></mxCell><mxCell id="google_out" value="11. Mã ủy quyền, ID token" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#e65100;strokeWidth=1.5;fontSize=11;fontColor=#bf360c;labelBackgroundColor=#ffffff;exitX=1;exitY=0.0521;exitDx=0;exitDy=0;entryX=0;entryY=0.2778;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="google"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="google_in" value="12. Danh tính đã xác minh" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#1565c0;strokeWidth=1.5;fontSize=11;fontColor=#0d47a1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7222;exitDx=0;exitDy=0;entryX=1;entryY=0.1354;entryDx=0;entryDy=0;" edge="1" parent="1" source="google" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="brevo" value="&lt;b&gt;Brevo&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;gửi email&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1440" y="430" width="240" height="90" as="geometry"/></mxCell><mxCell id="brevo_out" value="13. Email OTP, email sự cố" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#e65100;strokeWidth=1.5;fontSize=11;fontColor=#bf360c;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3646;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="brevo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fcm" value="&lt;b&gt;Firebase Cloud Messaging&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;push tới điện thoại&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1440" y="560" width="240" height="90" as="geometry"/></mxCell><mxCell id="fcm_out" value="14. Push thông báo" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#e65100;strokeWidth=1.5;fontSize=11;fontColor=#bf360c;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6354;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="fcm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="vision" value="&lt;b&gt;Google Cloud Vision&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;OCR hóa đơn&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1440" y="690" width="240" height="90" as="geometry"/></mxCell><mxCell id="vision_out" value="15. Ảnh hóa đơn" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#e65100;strokeWidth=1.5;fontSize=11;fontColor=#bf360c;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8646;exitDx=0;exitDy=0;entryX=0;entryY=0.2778;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="vision"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="vision_in" value="16. Văn bản nhận dạng" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#1565c0;strokeWidth=1.5;fontSize=11;fontColor=#0d47a1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7222;exitDx=0;exitDy=0;entryX=1;entryY=0.9479;entryDx=0;entryDy=0;" edge="1" parent="1" source="vision" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="llm" value="&lt;b&gt;Gemini / OpenRouter&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;mô hình ngôn ngữ&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="520" y="940" width="220" height="90" as="geometry"/></mxCell><mxCell id="llm_out" value="17. Câu chat,&lt;br&gt;tín hiệu ẩn danh,&lt;br&gt;bài báo" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#e65100;strokeWidth=1.5;fontSize=11;fontColor=#bf360c;labelBackgroundColor=#ffffff;exitX=-0.06;exitY=1;exitDx=0;exitDy=0;entryX=0.2273;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="llm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="llm_in" value="18. Ý định,&lt;br&gt;phương pháp gợi ý,&lt;br&gt;tín hiệu thị trường" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#1565c0;strokeWidth=1.5;fontSize=11;fontColor=#0d47a1;labelBackgroundColor=#ffffff;exitX=0.7727;exitY=0;exitDx=0;exitDy=0;entryX=0.18;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="llm" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sepay" value="&lt;b&gt;SePay&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;cổng thanh toán&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="800" y="940" width="200" height="90" as="geometry"/></mxCell><mxCell id="sepay_out" value="19. Tạo,&lt;br&gt;tra cứu đơn" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#e65100;strokeWidth=1.5;fontSize=11;fontColor=#bf360c;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="sepay"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sepay_in" value="20. IPN,&lt;br&gt;trạng thái đơn" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#1565c0;strokeWidth=1.5;fontSize=11;fontColor=#0d47a1;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sepay" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="market" value="&lt;b&gt;Trang tin thị trường&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;link do Admin nhập&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1060" y="940" width="200" height="90" as="geometry"/></mxCell><mxCell id="market_in" value="21. Giá nhiên liệu,&lt;br&gt;tin thị trường" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#1565c0;strokeWidth=1.5;fontSize=11;fontColor=#0d47a1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.96;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="market" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend_title" value="&lt;b&gt;CHÚ GIẢI&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1440" y="110" width="200" height="24" as="geometry"/></mxCell><mxCell id="lg0" value="" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1440" y="140" width="34" height="20" as="geometry"/></mxCell><mxCell id="lgt0" value="Hệ thống (quá trình 0)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1484" y="138" width="200" height="24" as="geometry"/></mxCell><mxCell id="lg1" value="" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1440" y="170" width="34" height="20" as="geometry"/></mxCell><mxCell id="lgt1" value="Tác nhân con người" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1484" y="168" width="200" height="24" as="geometry"/></mxCell><mxCell id="lg2" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1440" y="200" width="34" height="20" as="geometry"/></mxCell><mxCell id="lgt2" value="Hệ thống bên ngoài" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1484" y="198" width="200" height="24" as="geometry"/></mxCell><mxCell id="lge0" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1565c0;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1440" y="240" as="sourcePoint"/><mxPoint x="1474" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lget0" value="Luồng vào hệ thống" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1484" y="228" width="200" height="24" as="geometry"/></mxCell><mxCell id="lge1" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#e65100;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1440" y="266" as="sourcePoint"/><mxPoint x="1474" y="266" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lget1" value="Luồng ra khỏi hệ thống" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1484" y="254" width="200" height="24" as="geometry"/></mxCell><mxCell id="flows" value="&lt;table style='border-collapse:collapse;width:100%;font-size:12px'&gt;&lt;tr&gt;&lt;th style='border:1px solid #999;padding:4px 6px;background:#eeeeee;text-align:left'&gt;Luồng&lt;/th&gt;&lt;th style='border:1px solid #999;padding:4px 6px;background:#eeeeee;text-align:left'&gt;Hướng&lt;/th&gt;&lt;th style='border:1px solid #999;padding:4px 6px;background:#eeeeee;text-align:left'&gt;Nội dung&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Người dùng → FinMate&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Đăng ký, đăng nhập, mã OTP, đồng ý điều khoản; ví theo dõi, thu nhập dự kiến, ngân sách, ngưỡng cảnh báo, khảo sát phương pháp tài chính, mục tiêu tiết kiệm; giao dịch nhập bằng câu chat, giọng nói, ảnh hóa đơn, quét QR; xác nhận bản nháp; nhóm tài chính, ticket hỗ trợ, đồng ý cho nhân viên xem dữ liệu, bài cộng đồng, mua gói.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;FinMate → Người dùng&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Bản nháp cần xác nhận, số dư và ngân sách, cảnh báo ngưỡng chi tiêu, dự báo dòng tiền và số tiền được tiêu, giao dịch bất thường, insight, cảnh báo thị trường, trả lời ticket, trạng thái gói.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;&lt;b&gt;3&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Staff → FinMate&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Nhận và trả lời ticket, xin quyền xem dữ liệu khách, tạo giao dịch nháp, khóa khẩn cấp, đề xuất việc nhạy cảm, kiểm duyệt bài và ảnh cộng đồng.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;&lt;b&gt;4&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;FinMate → Staff&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Hàng đợi ticket và hạn SLA; ví, giao dịch, ngân sách của khách khi khách đồng ý theo từng ca; mã OTP đăng nhập web.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;&lt;b&gt;5&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;OpsManager → FinMate&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Phân công ticket, đổi mức ưu tiên, gom ca; duyệt hoặc từ chối đề xuất; nhận xử lý, đóng sự cố; câu trả lời mẫu; cấm đăng cộng đồng; cấu hình gói đăng ký và giá.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;&lt;b&gt;6&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;FinMate → OpsManager&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Dashboard SLA và tải việc, audit vận hành, thống kê AI, trạng thái dịch vụ và sự cố, đơn mua gói.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;&lt;b&gt;7&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Admin → FinMate&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Phân quyền, cấu hình hệ thống và cờ tính năng, khóa API bên thứ ba, mẫu thông báo ngân hàng, mô hình AI và Rasa, phương pháp tài chính, khảo sát, nguồn tin thị trường.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;&lt;b&gt;8&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;FinMate → Admin&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Nhật ký audit, chi tiết kỹ thuật của sự cố, danh sách lỗi ứng dụng, thống kê AI.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;&lt;b&gt;9&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Android OS → FinMate&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Thông báo biến động số dư từ app ngân hàng và ví người dùng đã chọn, sau khi lọc trên thiết bị. FinMate không kết nối tài khoản ngân hàng.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;&lt;b&gt;10&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;FinMate → App ngân hàng&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Deep link qua dl.vietqr.io mở app ngân hàng với thông tin chuyển khoản. FinMate không chuyển tiền; giao dịch được khớp lại qua luồng 9.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;&lt;b&gt;11&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;FinMate → Google&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Chuyển hướng đăng nhập kèm state, đổi mã ủy quyền lấy ID token.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Google → FinMate&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;ID token chứa email và danh tính đã xác minh.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;&lt;b&gt;13&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;FinMate → Brevo&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Email mã OTP (xác minh, quên mật khẩu, đăng nhập web vận hành) và email báo sự cố cho Admin, OpsManager.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;&lt;b&gt;14&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;FinMate → FCM&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Push tới điện thoại người dùng: bản nháp, cảnh báo, trả lời ticket.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;&lt;b&gt;15&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;FinMate → Vision&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Ảnh hóa đơn (chỉ khi có khóa Vision, nếu không thì OCR chạy nội bộ).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Vision → FinMate&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Văn bản nhận dạng từ ảnh.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;&lt;b&gt;17&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;FinMate → Gemini / OpenRouter&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Câu chat cần hiểu ý định, tín hiệu khảo sát ẩn danh, bài báo thị trường. Số tiền và danh mục không lấy từ mô hình.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;&lt;b&gt;18&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Gemini / OpenRouter → FinMate&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Ý định câu chat, phương pháp tài chính gợi ý, tín hiệu thị trường kèm trích dẫn để đối chiếu.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;&lt;b&gt;19&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;FinMate → SePay&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Tạo đơn thanh toán gói, tra cứu chi tiết đơn để xác nhận số tiền.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;&lt;b&gt;20&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;SePay → FinMate&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;IPN báo thanh toán. Chỉ là tín hiệu; gói chỉ được cấp sau khi tra cứu ở luồng 19.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;&lt;b&gt;21&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Trang tin thị trường → FinMate&lt;/td&gt;&lt;td style='border:1px solid #999;padding:4px 6px;vertical-align:top;text-align:left'&gt;Nội dung trang do Admin nhập, đọc 3 giờ một lần, tôn trọng robots.txt. Không lưu nội dung bài.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1"><mxGeometry x="60" y="1090" width="1620" height="760" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>