<mxCell id="l5" value="Mo hinh LLM ben thu ba" style="swimlane;horizontal=0;startSize=24;html=1;" vertex="1" parent="pool"><mxGeometry x="30" y="630" width="1530" height="90" as="geometry"/></mxCell>
<mxCell id="l6" value="Nhan su (Content / Support / Manager)" style="swimlane;horizontal=0;startSize=24;html=1;" vertex="1" parent="pool"><mxGeometry x="30" y="720" width="1530" height="110" as="geometry"/></mxCell>
<mxCell id="a1" value="1. Dat cau hoi" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="l1"><mxGeometry x="60" y="35" width="140" height="50" as="geometry"/></mxCell>
<mxCell id="a2" value="POST /agent/ask (question)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="l2"><mxGeometry x="60" y="35" width="150" height="50" as="geometry"/></mxCell>
<mxCell id="a3" value="2. userId tu JWT, gioi han 20 luot/phut" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="l3"><mxGeometry x="60" y="60" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="a4" value="3. GATE: luat + bo phan loai y dinh (khong LLM): ngoai pham vi / dau tu / du lieu nguoi khac / tiem lenh -> tu choi" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="l4"><mxGeometry x="260" y="50" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="a5" value="4. PLAN: chon cong cu + tham so (JSON), so tien doi chieu bo doc so tat dinh" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="l5"><mxGeometry x="500" y="15" width="220" height="60" as="geometry"/></mxCell>
<mxCell id="a6" value="5. EXECUTE: cong cu trong danh sach cho phep, so nguyen dong, kem nguon + do tin cay" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="l3"><mxGeometry x="520" y="55" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="a7" value="6. COMPOSE: LLM viet menh de trich ma bang chung" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="l5"><mxGeometry x="800" y="15" width="220" height="60" as="geometry"/></mxCell>
<mxCell id="a8" value="7. VERIFY (Python): moi so tien = gia tri bang chung; sai -> sinh lai 1 lan -> cau mau" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="l4"><mxGeometry x="800" y="50" width="240" height="90" as="geometry"/></mxCell>
<mxCell id="a9" value="8. Tra AgentAnswerDto: status, claims, evidence (nguon, ngay, tin cay), verdict" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="l3"><mxGeometry x="1080" y="55" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="a10" value="9. The ket qua + Vi sao?" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="l2"><mxGeometry x="1100" y="35" width="200" height="50" as="geometry"/></mxCell>
<mxCell id="a11" value="Khong co bang chung -> ghi ma BAM cau hoi (khong noi dung)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;" vertex="1" parent="l4"><mxGeometry x="1100" y="40" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="a12" value="Soan tai lieu (Draft); Manager duyet -> Approved; chi tai lieu Approved vao RAG" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;" vertex="1" parent="l6"><mxGeometry x="1000" y="20" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="a13" value="Khieu nai: Open > Triaged > Responded > Resolved; ngoai le Escalated > ManagerReview > Resolved/Rejected; nguoi dung phan doi -> Reopened. Tro ly chi goi y, nhan su bam gui." style="rounded=1;whiteSpace=wrap;html=1;dashed=1;" vertex="1" parent="l6"><mxGeometry x="260" y="15" width="560" height="70" as="geometry"/></mxCell>
